{
  "name": "pagetime",
  "version": "2.0.0",
  "type": "module",
  "description": "Track time spent across websites",
  "scripts": {
    "dev": "vite build --watch --mode chrome",
    "dev:firefox": "vite build --watch --mode firefox",
    "build": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build:all": "vite build --mode chrome && vite build --mode firefox",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/chrome": "^0.0.300",
    "@types/webextension-polyfill": "^0.10.7",
    "svelte": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-web-extension": "^4.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
