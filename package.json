{
  "name": "pagetime",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "24.12.x"
  },
  "description": "Track time spent across websites",
  "scripts": {
    "dev": "vite build --watch --mode chrome",
    "dev:firefox": "vite build --watch --mode firefox",
    "build": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build:all": "vite build --mode chrome && vite build --mode firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "~7.2.0",
    "@types/webextension-polyfill": "~0.12.5",
    "svelte": "~5.56.8",
    "typescript": "~7.0.2",
    "vite": "~8.1.5",
    "vite-plugin-web-extension": "~4.5.1",
    "vitest": "~4.1.10"
  },
  "dependencies": {
    "webextension-polyfill": "~0.12.0"
  }
}
